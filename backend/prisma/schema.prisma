generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  MEMBER
  ADMIN
}

enum CourseLevel {
  BASE
  AVANCE
}

enum CourseContentType {
  VIDEO
  RESOURCE
  LIVE_SESSION
}

enum PaymentObject {
  INSCRIPTION_BASE
  INSCRIPTION_AVANCE
  PASSAGE_AVANCE
  ATTESTATION
}

enum PaymentMethod {
  WAVE
  ORANGE_MONEY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

enum PromotionType {
  PERCENTAGE
  FIXED
}

enum RedemptionStatus {
  RESERVED
  REDEEMED
  RELEASED
}

enum ProjectStatus {
  PENDING
  APPROVED
  NEEDS_IMPROVEMENT
}

enum QuestionStatus {
  OPEN
  SOLVED
  HIDDEN
}

enum ContentReportStatus {
  PENDING
  REVIEWED
  DISMISSED
}

enum CommunityEventMode {
  ONLINE
  IN_PERSON
}

enum JobType {
  EMPLOYMENT
  INTERNSHIP
  CONTRACT
}

enum JobStatus {
  PENDING
  PUBLISHED
  REJECTED
  CLOSED
}

model User {
  id                       String                   @id @default(cuid())
  name                     String
  email                    String                   @unique
  city                     String?
  bio                      String?
  passwordHash             String
  googleSubject            String?                  @unique
  role                     UserRole                 @default(MEMBER)
  interests                String[]                 @default([])
  newsletterSubscribed     Boolean                  @default(false)
  newsletterSubscribedAt   DateTime?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  registrations            CourseRegistration[]
  lessonProgress           LessonProgress[]
  payments                 Payment[]
  manuallyVerifiedPayments Payment[]                @relation("PaymentManualVerifier")
  projects                 CourseProject[]          @relation("ProjectOwner")
  showcaseProjects         ShowcaseProject[]
  showcaseProjectComments  ShowcaseProjectComment[]
  showcaseProjectLikes     ShowcaseProjectLike[]
  tipComments              TipComment[]
  tipLikes                 TipLike[]
  reviews                  CourseProject[]          @relation("ProjectReviewer")
  priceChanges             PriceChange[]
  attestations             Attestation[]
  magicLinkTokens          MagicLinkToken[]
  revokedAttestations      Attestation[]            @relation("AttestationRevoker")
  questions                CommunityQuestion[]
  answers                  CommunityAnswer[]
  answerComments           CommunityAnswerComment[]
  answerLikes              CommunityAnswerLike[]
  reports                  ContentReport[]          @relation("ReportAuthor")
  reviewedReports          ContentReport[]          @relation("ReportReviewer")
  eventRegistrations       EventRegistration[]
  createdEvents            CommunityEvent[]         @relation("EventCreator")
  createdJobs              JobOffer[]               @relation("JobCreator")
  reviewedJobs             JobOffer[]               @relation("JobReviewer")
  auditLogs                AdminAuditLog[]
  newsletterDeliveries     NewsletterDelivery[]
}

model NewsletterSubscriber {
  id             String               @id @default(cuid())
  email          String               @unique
  subscribedAt   DateTime             @default(now())
  unsubscribedAt DateTime?
  createdAt      DateTime             @default(now())
  deliveries     NewsletterDelivery[]
}

model Course {
  id               String               @id @default(cuid())
  title            String
  description      String
  language         String               @default("Français")
  level            String               @default("Débutant")
  instructorName   String               @default("Sunu Tech Hub")
  duration         String               @default("")
  coverImageUrl    String?
  lessons          Int                  @default(0)
  subjects         String[]             @default([])
  isFree           Boolean              @default(false)
  basePrice        Int?
  advancedPrice    Int?
  upgradePrice     Int?
  attestationPrice Int?
  active           Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  registrations    CourseRegistration[]
  contents         CourseContent[]
  lessonProgress   LessonProgress[]
  payments         Payment[]
  projects         CourseProject[]
  priceChanges     PriceChange[]
  attestations     Attestation[]

  @@index([active, createdAt])
}

model CourseContent {
  id            String                      @id @default(cuid())
  courseId      String
  type          CourseContentType
  title         String
  description   String                      @default("")
  url           String
  scheduledAt   DateTime?
  position      Int                         @default(0)
  published     Boolean                     @default(false)
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt
  course        Course                      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress      LessonProgress[]
  notifications CourseContentNotification[]

  @@index([courseId, published, position])
}

model Tip {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  description   String   @default("")
  htmlContent   String   @db.Text
  narrationPath String?
  published     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  comments      TipComment[]
  likes         TipLike[]

  @@index([published, createdAt])
}

model TipLike {
  userId    String
  tipId     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tip       Tip      @relation(fields: [tipId], references: [id], onDelete: Cascade)

  @@id([userId, tipId])
  @@index([tipId])
}

model TipComment {
  id        String   @id @default(cuid())
  body      String   @db.Text
  userId    String
  tipId     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tip       Tip      @relation(fields: [tipId], references: [id], onDelete: Cascade)

  @@index([tipId, createdAt])
}

model LessonProgress {
  id          String        @id @default(cuid())
  userId      String
  courseId    String
  contentId   String
  completedAt DateTime      @default(now())
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  content     CourseContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@index([userId, courseId])
}

model CourseRegistration {
  id             String      @id @default(cuid())
  userId         String
  courseId       String
  level          CourseLevel
  startsAt       DateTime?
  endsAt         DateTime?
  reminderSentAt DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  course         Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  payments       Payment[]

  @@unique([userId, courseId])
  @@index([userId, endsAt])
}

model Payment {
  id                String               @id @default(cuid())
  reference         String               @unique
  userId            String
  courseId          String?
  registrationId    String?
  projectId         String?
  promotionId       String?
  object            PaymentObject
  level             CourseLevel?
  method            PaymentMethod
  status            PaymentStatus        @default(PENDING)
  amountBeforePromo Int
  amountPaid        Int
  discountAmount    Int                  @default(0)
  currency          String
  accessDays        Int
  promoCode         String?
  providerToken     String?
  checkoutUrl       String?
  providerReference String?
  manualVerifiedAt  DateTime?
  manualVerifierId  String?
  createdAt         DateTime             @default(now())
  paidAt            DateTime?
  user              User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  course            Course?              @relation(fields: [courseId], references: [id], onDelete: Restrict)
  project           CourseProject?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  registration      CourseRegistration?  @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  promotion         Promotion?           @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  redemption        PromotionRedemption?
  receipt           ReceiptOutbox?
  attestation       Attestation?
  manualVerifier    User?                @relation("PaymentManualVerifier", fields: [manualVerifierId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model PriceSetting {
  key        String   @id
  value      String
  modifiedBy String?
  updatedAt  DateTime @updatedAt
}

model PriceChange {
  id         String   @id @default(cuid())
  key        String
  oldValue   String?
  newValue   String
  modifiedBy String
  changedAt  DateTime @default(now())
  user       User     @relation(fields: [modifiedBy], references: [id], onDelete: Restrict)
  courseId   String?
  course     Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([changedAt])
  @@index([courseId, changedAt])
}

model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Announcement {
  id                   String               @id @default(cuid())
  title                String
  body                 String
  link                 String?
  published            Boolean              @default(false)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  newsletterDeliveries NewsletterDelivery[]

  @@index([published, updatedAt])
}

model NewsletterDelivery {
  id             String                @id @default(cuid())
  campaignKey    String
  announcementId String?
  eventId        String?
  userId         String?
  subscriberId   String?
  recipientEmail String
  recipientName  String
  subject        String
  body           String
  link           String?
  attempts       Int                   @default(0)
  nextAttemptAt  DateTime              @default(now())
  lockedUntil    DateTime?
  sentAt         DateTime?
  cancelledAt    DateTime?
  lastError      String?
  createdAt      DateTime              @default(now())
  announcement   Announcement?         @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  event          CommunityEvent?       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user           User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriber     NewsletterSubscriber? @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@unique([campaignKey, recipientEmail])
  @@index([sentAt, cancelledAt, nextAttemptAt])
}

model Promotion {
  id          String                @id @default(cuid())
  code        String                @unique
  type        PromotionType
  value       Int
  startsAt    DateTime              @default(now())
  expiresAt   DateTime
  usageLimit  Int?
  usedCount   Int                   @default(0)
  active      Boolean               @default(true)
  createdAt   DateTime              @default(now())
  payments    Payment[]
  redemptions PromotionRedemption[]

  @@index([active, expiresAt])
}

model PromotionRedemption {
  id          String           @id @default(cuid())
  promotionId String
  paymentId   String           @unique
  status      RedemptionStatus @default(RESERVED)
  createdAt   DateTime         @default(now())
  promotion   Promotion        @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  payment     Payment          @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([promotionId, status])
}

model CourseProject {
  id                  String        @id @default(cuid())
  userId              String
  courseId            String
  title               String
  description         String
  link                String?
  status              ProjectStatus @default(PENDING)
  reviewNote          String?
  submittedAt         DateTime      @default(now())
  reviewedAt          DateTime?
  reviewerId          String?
  user                User          @relation("ProjectOwner", fields: [userId], references: [id], onDelete: Cascade)
  course              Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  reviewer            User?         @relation("ProjectReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  attestationPayments Payment[]

  @@index([userId, courseId, status])
}

model ShowcaseProject {
  id            String                  @id @default(cuid())
  userId        String
  title         String
  description   String                  @db.Text
  link          String?
  technologies  String[]                @default([])
  imagePaths    String[]                @default([])
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments      ShowcaseProjectComment[]
  likes         ShowcaseProjectLike[]

  @@index([createdAt])
  @@index([userId, createdAt])
}

model ShowcaseProjectComment {
  id        String          @id @default(cuid())
  projectId String
  userId    String
  body      String          @db.VarChar(2000)
  createdAt DateTime        @default(now())
  project   ShowcaseProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([userId, createdAt])
}

model ShowcaseProjectLike {
  projectId String
  userId    String
  createdAt DateTime        @default(now())
  project   ShowcaseProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@index([projectId, createdAt])
}

model Attestation {
  id                String            @id @default(cuid())
  number            String            @unique
  userId            String
  courseId          String
  paymentId         String?           @unique
  freeCourseKey     String?           @unique
  status            AttestationStatus @default(ACTIVE)
  displayNamePublic Boolean           @default(false)
  issuedAt          DateTime          @default(now())
  revokedAt         DateTime?
  revocationReason  String?
  revokedById       String?
  user              User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  course            Course            @relation(fields: [courseId], references: [id], onDelete: Restrict)
  payment           Payment?          @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  revokedBy         User?             @relation("AttestationRevoker", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([userId, issuedAt])
}

enum AttestationStatus {
  ACTIVE
  REVOKED
}

model ReceiptOutbox {
  id            String    @id @default(cuid())
  paymentId     String    @unique
  recipient     String
  subject       String
  text          String
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  sentAt        DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())
  payment       Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([sentAt, nextAttemptAt])
}

model CourseContentNotification {
  id            String        @id @default(cuid())
  contentId     String
  recipient     String
  recipientName String
  attempts      Int           @default(0)
  nextAttemptAt DateTime      @default(now())
  lockedUntil   DateTime?
  sentAt        DateTime?
  lastError     String?
  createdAt     DateTime      @default(now())
  content       CourseContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([contentId, recipient])
  @@index([sentAt, nextAttemptAt])
}

model MagicLinkToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt, expiresAt])
  @@index([expiresAt])
}

model CommunityQuestion {
  id        String            @id @default(cuid())
  title     String
  body      String
  subjects  String[]          @default([])
  status    QuestionStatus    @default(OPEN)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers   CommunityAnswer[]
  reports   ContentReport[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model CommunityAnswer {
  id         String                   @id @default(cuid())
  body       String
  hidden     Boolean                  @default(false)
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt
  questionId String
  userId     String
  question   CommunityQuestion        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user       User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports    ContentReport[]
  comments   CommunityAnswerComment[]
  likes      CommunityAnswerLike[]

  @@index([questionId, hidden, createdAt])
}

model CommunityAnswerComment {
  id        String          @id @default(cuid())
  body      String
  createdAt DateTime        @default(now())
  answerId  String
  userId    String
  answer    CommunityAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([answerId, createdAt])
  @@index([userId, createdAt])
}

model CommunityAnswerLike {
  answerId  String
  userId    String
  createdAt DateTime        @default(now())
  answer    CommunityAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, answerId])
  @@index([answerId, createdAt])
}

model ContentReport {
  id         String              @id @default(cuid())
  reason     String
  details    String?
  status     ContentReportStatus @default(PENDING)
  createdAt  DateTime            @default(now())
  reviewedAt DateTime?
  reporterId String
  reviewerId String?
  questionId String?
  answerId   String?
  reporter   User                @relation("ReportAuthor", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewer   User?               @relation("ReportReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  question   CommunityQuestion?  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer     CommunityAnswer?    @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model CommunityEvent {
  id                   String               @id @default(cuid())
  title                String
  description          String
  startsAt             DateTime
  endsAt               DateTime?
  location             String
  mode                 CommunityEventMode
  capacity             Int?
  active               Boolean              @default(true)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  createdById          String
  createdBy            User                 @relation("EventCreator", fields: [createdById], references: [id], onDelete: Restrict)
  registrations        EventRegistration[]
  newsletterDeliveries NewsletterDelivery[]

  @@index([active, startsAt])
}

model EventRegistration {
  id        String         @id @default(cuid())
  eventId   String
  userId    String
  createdAt DateTime       @default(now())
  event     CommunityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId, createdAt])
}

model JobOffer {
  id           String    @id @default(cuid())
  title        String
  company      String
  city         String
  type         JobType
  level        String
  description  String
  applyUrl     String?
  status       JobStatus @default(PENDING)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdById  String
  reviewedById String?
  createdBy    User      @relation("JobCreator", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedBy   User?     @relation("JobReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

model SecurityEvent {
  id            String   @id @default(cuid())
  eventType     String
  severity      String
  sourceIp      String?
  userAgent     String?
  method        String
  path          String
  statusCode    Int
  reason        String?
  targetAccount String?
  userId        String?
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([eventType, createdAt])
  @@index([sourceIp, createdAt])
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entity      String
  entityId    String?
  before      Json?
  after       Json?
  createdAt   DateTime @default(now())
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}
