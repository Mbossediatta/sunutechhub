NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sunu_tech_hub?schema=public
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=https://your-public-frontend.example.com

# Configure these with credentials from the PayTech dashboard.
PAYTECH_API_KEY=
PAYTECH_API_SECRET=
PAYTECH_ENV=test
PAYTECH_API_URL=https://paytech.sn/api/payment/request-payment
PAYTECH_PUBLIC_API_URL=https://your-public-api.example.com

# SMTP Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_SECURE=false
SMTP_FROM=Sunu Tech Hub <noreply@example.com>

# Optional first administrator created by `npm run db:seed`.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administration Sunu Tech Hub
SMTP_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
